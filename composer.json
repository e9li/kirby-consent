{
    "name": "e9li/kirby-consent",
    "description": "Cookie consent banner with script gating and Google Consent Mode v2 for Kirby",
    "type": "kirby-plugin",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Rafael Egli",
            "email": "rafael@e9li.com",
            "homepage": "https://www.e9li.com"
        }
    ],
    "support": {
        "docs": "https://github.com/e9li/kirby-consent/blob/main/README.md",
        "source": "https://github.com/e9li/kirby-consent",
        "issues": "https://github.com/e9li/kirby-consent/issues"
    },
    "keywords": [
        "kirby",
        "kirby-cms",
        "kirby-plugin",
        "cookie",
        "consent",
        "gdpr",
        "dsgvo",
        "tdddg",
        "privacy"
    ],
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "getkirby/composer-installer": true
        }
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
        "getkirby/composer-installer": "^1.2"
    },
    "extra": {
        "installer-name": "consent"
    }
}
